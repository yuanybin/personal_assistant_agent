# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_LOG_LEVEL=info
SERVER_ENVIRONMENT=development

# WeChat Work
WEWORK_TOKEN=your_token_here
WEWORK_ENCODING_AES_KEY=your_43_char_aes_key_here
WEWORK_CORP_ID=ww1234567890abcdef

# Feishu
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=

# DingTalk
DINGTALK_CLIENT_ID=dingxxxxxxxxxxxxx
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_ROBOT_CODE=

# Comma-separated list of platforms to enable
CHANNELS_ENABLED=wechat_work,feishu,dingtalk
